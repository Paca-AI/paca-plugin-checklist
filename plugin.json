{
  "id": "com.paca.checklist",
  "displayName": "Checklist",
  "description": "Adds named checklists with checkable items to tasks.",
  "version": "0.2.13",
  "minCoreVersion": "v0.19.0",
  "permissions": ["db.read", "db.write", "events.subscribe"],
  "backend": {
    "eventSubscriptions": ["task.deleted"],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/checklists",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/checklists",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/tasks/:taskId/checklists/:checklistId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/tasks/:taskId/checklists/:checklistId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/checklists/:checklistId/items",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/tasks/:taskId/checklists/:checklistId/items/:itemId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/tasks/:taskId/checklists/:checklistId/items/:itemId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requireActions",
            "scope": "project",
            "actions": ["tasks:write"]
          }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.checklist/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "task.detail.section",
        "component": "ChecklistsSection",
        "order": 10
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.checklist/mcp.js",
    "toolContextHooks": ["get_task"]
  }
}
